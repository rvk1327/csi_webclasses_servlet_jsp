<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>hello</servlet-name>
        <servlet-class>controller.WelcomeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RequestAndResponse</servlet-name>
        <servlet-class>controller.RequestAndResponse</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>controller.HomeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Inbox</servlet-name>
        <servlet-class>controller.Inbox</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SentItems</servlet-name>
        <servlet-class>controller.SentItems</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Draft</servlet-name>
        <servlet-class>controller.Draft</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Logout</servlet-name>
        <servlet-class>controller.Logout</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>QueryValue</servlet-name>
        <servlet-class>controller.QueryValue</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteData</servlet-name>
        <servlet-class>controller.DeleteData</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateStudent</servlet-name>
        <servlet-class>controller.UpdateStudent</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FileUploadData</servlet-name>
        <servlet-class>controller.FileUploadData</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DownloadData</servlet-name>
        <servlet-class>controller.DownloadData</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>hello</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RequestAndResponse</servlet-name>
        <url-pattern>/reqandres</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/homeservlet</url-pattern>
    </servlet-mapping>
    <filter>
        <filter-name>login_filter</filter-name>
        <filter-class>controller.LoginVerify</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>login_filter</filter-name>
        <url-pattern>/homeservlet</url-pattern>
    </filter-mapping>
    <servlet-mapping>
        <servlet-name>Inbox</servlet-name>
        <url-pattern>/inbox</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SentItems</servlet-name>
        <url-pattern>/sent_items</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Draft</servlet-name>
        <url-pattern>/draft</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>QueryValue</servlet-name>
        <url-pattern>/queryvalue</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteData</servlet-name>
        <url-pattern>/deletedata</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UpdateStudent</servlet-name>
        <url-pattern>/updatestudent</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FileUploadData</servlet-name>
        <url-pattern>/fileuploaddata</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DownloadData</servlet-name>
        <url-pattern>/downloaddata</url-pattern>
    </servlet-mapping>
</web-app>
